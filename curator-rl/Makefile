# requirements.lock pins the CPU stack (core + dev + viz), generated by:
#   pip-compile --strip-extras --extra dev --extra viz --output-file requirements.lock pyproject.toml
# (it is a pip file, not a makefile: install it with `make install-locked`)
SRC := src/curator_rl

.PHONY: install install-locked lock test lint smoke

install:
	python -m pip install -e ".[dev,viz]"

install-locked:
	python -m pip install -r requirements.lock
	python -m pip install -e . --no-deps

lock:
	python -m piptools compile --strip-extras --extra dev --extra viz --output-file requirements.lock pyproject.toml

test:
	python -m pytest tests

lint:
	ruff check .

smoke:
	python -m curator_rl.cli init-run --config configs/experiment/smoke.yaml --set experiment.seed=0
